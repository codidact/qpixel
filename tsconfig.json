{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "declaration": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "es2022",
    "moduleResolution": "node",
    "noEmit": true,
    "target": "ES2021",
    "types": ["./global.d.ts", "@types/jquery", "moment", "@types/select2"]
  },
  "include": ["./app/assets/javascripts", "./public/assets/community"],
  "exclude": [
    "config",
    "db",
    "docker",
    "images",
    "img",
    "lib",
    "log",
    "scripts",
    "static",
    "test",
    "tmp",
    "vendor",
    "node_modules"
  ]
}
