<% content_for :title, t('admin.dashboard.title') %>

<%= link_to moderator_path, class: "has-font-size-small" do %>
  Switch to Moderator Tools
<% end %>

<h1><%= t('admin.dashboard.title') %></h1>
<p><%= t('admin.dashboard.blurb') %></p>

<div class="grid">
  <% if current_user.global_admin? %>
    <%= render 'action_card', icon: 'cogs', action: 'global_settings', label_key: 'g_site_settings', is_global: true %>
    <%= render 'action_card', icon: 'tags', action: 'global_tag_sets', label_key: 'g_tag_sets', is_global: true %>
    <%= render 'action_card', icon: 'mail-bulk', action: 'post_types', is_global: true %>
    <%= render 'action_card', icon: 'folder-plus', action: 'email_all', is_global: true %>
    <%= render 'action_card', icon: 'envelope', action: 'moderator_email', label_key: 'email_moderators', is_global: true %>
  <% end %>

  <%= render 'action_card', icon: 'cogs', action: 'site_settings' %>
  <%= render 'action_card', icon: 'tags', action: 'tag_sets' %>
  <%= render 'action_card', icon: 'briefcase', action: 'categories' %>
  <%= render 'action_card', icon: 'sliders-h', action: 'admin_privileges', label_key: 'abilities' %>
  <%= render 'action_card', icon: 'exclamation-triangle', action: 'admin_error_reports', label_key: 'error_reports' %>
  <%= render 'action_card', icon: 'hand-paper', action: 'close_reasons' %>
  <%= render 'action_card', icon: 'balance-scale', action: 'licenses' %>
  <%= render 'action_card', icon: 'user-secret', action: 'audit_logs' %>

  <% if current_user.global_admin? %>
    <%= render 'action_card', icon: 'user-plus', action: 'new_site' %>
  <% end %>

  <%= render 'action_card', icon: 'user', action: 'admin_email_query' %>
</div>
